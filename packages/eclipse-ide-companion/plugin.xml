<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <!-- Start the companion server as soon as the workbench is up. -->
   <extension point="org.eclipse.ui.startup">
      <startup class="com.moli.code.eclipse.StartupHook"/>
   </extension>

   <!-- Main menu: 몰리 코드 -->
   <extension point="org.eclipse.ui.actionSets">
      <actionSet
            id="com.moli.code.eclipse.actionSet"
            label="몰리 코드 (Moli Code)"
            visible="true">
         <menu
               id="com.moli.code.eclipse.menu"
               label="몰리 코드">
            <separator name="cvs"/>
            <separator name="misc"/>
         </menu>
         <action
               id="com.moli.code.eclipse.action.cvsDiff"
               label="CVS 변경 확인 (diff)"
               tooltip="선택한 리소스의 CVS diff를 콘솔에 출력합니다"
               menubarPath="com.moli.code.eclipse.menu/cvs"
               class="com.moli.code.eclipse.actions.CvsDiffAction"/>
         <action
               id="com.moli.code.eclipse.action.cvsUpdate"
               label="CVS 업데이트 (update)"
               tooltip="저장소의 최신 내용으로 작업 공간을 갱신합니다"
               menubarPath="com.moli.code.eclipse.menu/cvs"
               class="com.moli.code.eclipse.actions.CvsUpdateAction"/>
         <action
               id="com.moli.code.eclipse.action.cvsCommit"
               label="CVS 커밋 (commit)..."
               tooltip="검토를 마친 변경 사항을 CVS 저장소에 커밋합니다"
               menubarPath="com.moli.code.eclipse.menu/cvs"
               class="com.moli.code.eclipse.actions.CvsCommitAction"/>
         <action
               id="com.moli.code.eclipse.action.serverStatus"
               label="몰리 코드 연결 상태"
               tooltip="Moli Code CLI가 연결할 수 있는 서버 정보를 표시합니다"
               menubarPath="com.moli.code.eclipse.menu/misc"
               class="com.moli.code.eclipse.actions.ServerStatusAction"/>
      </actionSet>
   </extension>

   <!-- Context menu on any resource (Navigator / Package Explorer). -->
   <extension point="org.eclipse.ui.popupMenus">
      <objectContribution
            id="com.moli.code.eclipse.popup"
            objectClass="org.eclipse.core.resources.IResource"
            adaptable="true">
         <menu
               id="com.moli.code.eclipse.popupMenu"
               label="몰리 코드"
               path="additions">
            <separator name="cvs"/>
         </menu>
         <action
               id="com.moli.code.eclipse.popup.cvsDiff"
               label="CVS 변경 확인 (diff)"
               menubarPath="com.moli.code.eclipse.popupMenu/cvs"
               class="com.moli.code.eclipse.actions.CvsDiffAction"/>
         <action
               id="com.moli.code.eclipse.popup.cvsUpdate"
               label="CVS 업데이트 (update)"
               menubarPath="com.moli.code.eclipse.popupMenu/cvs"
               class="com.moli.code.eclipse.actions.CvsUpdateAction"/>
         <action
               id="com.moli.code.eclipse.popup.cvsCommit"
               label="CVS 커밋 (commit)..."
               menubarPath="com.moli.code.eclipse.popupMenu/cvs"
               class="com.moli.code.eclipse.actions.CvsCommitAction"/>
      </objectContribution>
   </extension>

</plugin>
